# =============================================================================
# Shama TTS Service — Environment Variables
# Copy this to .env and fill in your values
# =============================================================================

# ElevenLabs (free tier: 10,000 chars/month)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs pre-made multilingual voices (defaults shown)
# ELEVENLABS_VOICE_MALE=onwK4e9ZLuTAKqWW03F9     # Daniel
# ELEVENLABS_VOICE_FEMALE=XB0fDUnXU5powFXDhCwa    # Charlotte
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Monthly character budget
# TTS_MONTHLY_CHAR_LIMIT=10000
# TTS_CHAR_WARNING_THRESHOLD=0.8

# Supabase Storage (free tier: 1GB)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
# SUPABASE_BUCKET=tts-audio

# Rate limiting
# TTS_RATE_LIMIT_REQUESTS=5
# TTS_RATE_LIMIT_WINDOW=60
