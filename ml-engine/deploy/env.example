# =============================================================================
# Shama ML Engine — Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# --- LLM Providers (FREE tiers available) ---
# Groq: https://console.groq.com — free tier: 30 req/min, 14.4K tokens/min
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini: https://aistudio.google.com — free tier: 15 req/min, 1M tokens/day
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Text-to-Speech ---
# ElevenLabs: https://elevenlabs.io — free tier: 10K chars/month
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Database and Storage ---
# Supabase: https://supabase.com — free tier: 500MB DB, 1GB storage
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# --- Application Config ---
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8000

# Cache TTL in seconds (24 hours default)
CACHE_TTL_SECONDS=86400

# Max concurrent requests (keep low for 512MB RAM)
MAX_CONCURRENT_REQUESTS=10

# --- Model Config ---
# Force CPU-only inference (required for Render free tier 512MB RAM)
TORCH_CPU_ONLY=1

# Embedding model — all-MiniLM-L6-v2 (~90MB, 384 dimensions)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Optional: Monitoring ---
# Sentry DSN for error tracking (free tier: 5K events/month)
# SENTRY_DSN=https://xxxx@o1234.ingest.sentry.io/5678

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:3000
